# Copy to .env and fill in. ATLAS reads these from the environment / .env file.
# AI engine: Google Gemini (free) — get a key at aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
# Accounts (optional) — Supabase project → Settings → API:
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret
# Durable data (optional) — Supabase → Settings → Database → Connection string (URI):
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Telegram channel (optional) — get a token from @BotFather:
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# Phone calls (optional) — Twilio (console.twilio.com). ATLAS can call people and
# play a saved recording or speak a message. PUBLIC_BASE_URL must be a PUBLIC https
# URL where this app is reachable (your Render deploy, or an ngrok tunnel to :8077)
# so Twilio can fetch the call audio/TwiML — localhost will NOT work for live calls.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# PUBLIC_BASE_URL=https://your-atlas.onrender.com
# Optional overrides:
# ATLAS_MODEL=gemini-flash-latest
# ATLAS_TZ=Asia/Kolkata
# ATLAS_DB=atlas.db
