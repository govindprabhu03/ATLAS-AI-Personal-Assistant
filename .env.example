# Copy to .env and fill in. ATLAS reads these from the environment / .env file.
# AI engine: Google Gemini (free) — get a key at aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
# Accounts (optional) — Supabase project → Settings → API:
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret
# Telegram channel (optional) — get a token from @BotFather:
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# Optional overrides:
# ATLAS_MODEL=gemini-2.5-flash
# ATLAS_TZ=Asia/Kolkata
# ATLAS_DB=atlas.db
